# Flask Configuration
FLASK_APP=backend/wsgi.py
FLASK_ENV=dev
SECRET_KEY=your-secret-key-here-change-in-production

# Database Configuration
DATABASE_URL=postgresql://matcha_user:matcha_password@db:5432/matcha_db

# PostgreSQL Configuration (used by docker-compose)
POSTGRES_USER=matcha_user
POSTGRES_PASSWORD=matcha_password
POSTGRES_DB=matcha_db

# Database Pool Configuration
DB_POOL_MIN_CONN=2
DB_POOL_MAX_CONN=10

# CORS Configuration
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# JWT Configuration (if using JWT tokens)
JWT_SECRET_KEY=your-jwt-secret-key-here
JWT_ACCESS_TOKEN_EXPIRES=3600
JWT_REFRESH_TOKEN_EXPIRES=2592000

# Logging
LOG_LEVEL=INFO

# Application Settings
APP_NAME=Matcha
API_VERSION=1.0.0
