# ─────────────────────────────────────────────────────────────
#  PRODUCTION ENVIRONMENT – copy to .env.prod and fill values
#  NEVER commit .env.prod to version control
# ─────────────────────────────────────────────────────────────

# Flask
FLASK_APP=app.wsgi
FLASK_ENV=prod
SECRET_KEY=change-me-strong-random-secret
LOG_LEVEL=WARNING

# Database (PostgreSQL)
POSTGRES_USER=matcha_user
POSTGRES_PASSWORD=change-me-strong-db-password
POSTGRES_DB=matcha_db
DATABASE_URL=postgresql://matcha_user:change-me-strong-db-password@db:5432/matcha_db
DB_POOL_MIN_CONN=10
DB_POOL_MAX_CONN=50

# JWT
JWT_SECRET_KEY=change-me-strong-jwt-secret
JWT_ACCESS_TOKEN_MINUTES=15
JWT_REFRESH_TOKEN_DAYS=30
JWT_COOKIE_SECURE=true
JWT_COOKIE_SAMESITE=Strict
JWT_COOKIE_CSRF_PROTECT=true

# CORS / URLs  (replace with your actual domain)
FRONTEND_URL=https://yourdomain.com
BACKEND_URL=https://yourdomain.com
CORS_ORIGINS=https://yourdomain.com
NEXT_PUBLIC_API_URL=https://yourdomain.com/api/v1
NEXT_PUBLIC_SOCKET_URL=https://yourdomain.com

# Socket.IO
SOCKETIO_ASYNC_MODE=eventlet
SOCKETIO_CORS_ORIGINS=https://yourdomain.com
SOCKETIO_PING_INTERVAL=25
SOCKETIO_PING_TIMEOUT=60

# Mail (SMTP)
MAIL_HOST=smtp.yourmailprovider.com
MAIL_PORT=587
MAIL_USER=no-reply@yourdomain.com
MAIL_PASSWORD=change-me-mail-password
MAIL_USE_TLS=true
MAIL_USE_SSL=false

# Media uploads
MAX_CONTENT_LENGTH=33554432
MEDIA_PATH=static/media
AVATARS_UPLOAD_PATH=static/media/avatars
PICTURES_UPLOAD_PATH=static/media/pictures

# 42 Intra OAuth2
INTRA42_CLIENT_ID=
INTRA42_CLIENT_SECRET=
INTRA42_REDIRECT_URI=https://yourdomain.com/api/auth/oauth2/42/callback
INTRA42_FRONTEND_URL=https://yourdomain.com/complete-profile

# Pexels API (seeding only – optional in prod)
PEXELS_API_KEY1=

# Seed data
MOCK_USERS_PASS=

# App metadata
APP_NAME=Matcha
API_VERSION=1.0.0
